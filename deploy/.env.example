# ---- Trên server: cp .env.example .env && chmod 600 .env. File .env đã nằm trong .gitignore. ----

# Base URL đã đăng ký với chương trình — chỉ phần host, KHÔNG đổi
MOCK_DOMAIN=clinic-mock.example.com
# Email nhận cảnh báo hết hạn chứng chỉ từ Let's Encrypt
ACME_EMAIL=you@example.com

# ---- Biến của clinic-mock (pydantic-settings đọc từ env của container) ----
# Key PHẢI bắt đầu bằng "sk_" (gạch dưới). Key sai prefix bị bỏ qua im lặng -> 401 ở mọi request.
# Sinh key: echo "sk_grading_$(openssl rand -hex 12)"
# Quy ước: 1 key cho harness + bot khi chấm điểm, mỗi thành viên 1 key để dev.
# LƯU Ý: POST /_harness/reset xóa dữ liệu của MỌI key (Store.reset() khởi tạo lại toàn bộ).
MOCK_API_KEYS=sk_grading_CHANGE_ME,sk_dev_alice_CHANGE_ME,sk_dev_bob_CHANGE_ME

LOG_LEVEL=INFO
LOG_JSON_LOGS=true

# Không có Langfuse thì tắt, nếu không mock log lỗi kết nối liên tục (mặc định trong code là true)
LANGFUSE_TRACES_ENABLED=false
